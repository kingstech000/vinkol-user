{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Bash(flutter analyze:*)",
      "Bash(dart format --output=none:*)",
      "Bash(dart analyze:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find lib:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python3 .claude/scripts/contrast.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/design_guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking design tokens"
          }
        ]
      }
    ]
  }
}
